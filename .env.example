# Local settings for Marionette's scripts and agent skills. Copy to .env (which git ignores), or let
# Scripts/env.sh set KEY VALUE do it. A variable set in the environment wins over this file.
# One KEY=value per line; the value is taken literally, without quotes or expansion.

# Development provisioning profile (.mobileprovision) covering llc.turing.Marionette and the device.
MARIONETTE_DEVELOPMENT_PROFILE=
# Device to install on (`xcrun devicectl list devices`). `Scripts/env.sh set MARIONETTE_DEVICE --connected`
# saves the one that is connected.
MARIONETTE_DEVICE=

# App Store provisioning profile (.mobileprovision) covering llc.turing.Marionette.
MARIONETTE_DISTRIBUTION_PROFILE=
# App Store Connect API key (AuthKey_<key id>.p8) and its issuer ID.
MARIONETTE_ASC_KEY=
MARIONETTE_ASC_ISSUER=
# Only needed when the key's file name is not AuthKey_<key id>.p8.
MARIONETTE_ASC_KEY_ID=

# Keychain profile saved by Scripts/set-test-host.sh that Scripts/with-test-host.sh uses by default.
MARIONETTE_TEST_HOST_PROFILE=
